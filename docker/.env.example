# =============================================================================
# Переменные окружения для 3x-ui Docker Stack
# =============================================================================
# Скопировать в .env и заполнить:

# IP-адрес сервера (для REALITY SNI, подписки, etc.)
SERVER_IP=1.2.3.4

# Домен панели (для LE-сертификата, напр. panel.example.com)
PANEL_HOST=

# Внутренний порт панели 3x-ui (определяется при установке)
PANEL_PORT=45212

# Внешний порт stream-мастера nginx (по умолчанию 443)
STREAM_MASTER_PORT=443

# E-mail для Let's Encrypt (необязательно, но рекомендуется)
CERTBOT_EMAIL=

# Путь к проекту на сервере
PROJECT_DIR=/opt/3x-ui-docker
